{
  "name": "@skew/sdk",
  "version": "0.1.0",
  "description": "Skew SDK — create, buy, settle options on Solana in three lines",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
